PORT=5000
# Local run: mongodb://localhost:27017/classflow
# Inside docker compose: mongodb://mongo:27017/classflow
MONGO_URI=mongodb://localhost:27017/classflow
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google sign-in: OAuth 2.0 Client ID (Web application) from Google Cloud Console
GOOGLE_CLIENT_ID=

# Password-reset emails (example: Gmail with an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ClassFlow <no-reply@classflow.app>"

# Where the password-reset link points (the client app)
CLIENT_URL=http://localhost:5173
